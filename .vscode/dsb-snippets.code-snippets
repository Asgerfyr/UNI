	"DSB - Low-Pass Filter Design": {
		"scope": "python,jupyter",
		"prefix": ["dsb-lpf", "dsb-iir", "lpf", "low-pass", "iir-butterworth"],
		"body": [
			"from scipy import signal",
			"",
			"# Design low-pass filter",
			"f_c = ${1:1000}  # Cutoff frequency",
			"f_s = ${2:4000}  # Sampling frequency",
			"",
			"# Normalized cutoff frequency",
			"Wn = 2 * f_c / f_s",
			"",
			"# Design filter",
