		"body": [
			"# FFT symmetry for real-valued signals",
			"# Real signals have conjugate symmetry: X[k] = X*[N-k]",
			"",
			"X = np.fft.fft(x)  # x is real-valued",
			"",
			"# Check symmetry (should be approximately zero)",
			"symmetry_error = np.max(np.abs(X - np.conj(X[::-1])))",
			"print(f'Symmetry error (should be ~0): {symmetry_error:.2e}')",
			"",
			"# This is why we only plot positive frequencies",
			"# (negative frequencies contain no new information for real signals)"
		],
