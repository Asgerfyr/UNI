	"DSB - DFT Manual Calculation": {
		"scope": "python,jupyter",
		"prefix": ["dsb-dft-manual", "dsb-dft-loop", "dft-manual", "dft-calc"],
		"body": [
			"# Manual DFT calculation (for understanding)",
			"x = ${1:np.array([3, 0, -5, 1])}  # Input signal",
			"N = len(x)",
			"",
			"# DFT formula: X[k] = sum(x[n] * exp(-j*2*pi*k*n/N)) for n=0..N-1",
			"X = np.zeros(N, dtype=complex)",
			"W_N = np.exp(-2j * np.pi / N)  # Twiddle factor",
			"",
			"for k in range(N):",
			"    for n in range(N):",
			"        X[k] += x[n] * W_N**(k*n)",
			"",
			"print('Manual DFT:')",
			"print(X)",
			"",
			"# Compare with NumPy",
			"X_numpy = np.fft.fft(x)",
			"print('NumPy FFT:')",
			"print(X_numpy)"
		],
		"description": "Manual DFT calculation to understand the algorithm"
	},

